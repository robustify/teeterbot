<?xml version="1.0" ?>
<sdf version="1.9">
    <model name='teeterbot'>
        <link name="body_com">
            <sensor name="imu_sensor" type="imu">
                <always_on>1</always_on>
                <update_rate>100</update_rate>
                <visualize>false</visualize>
                <topic>imu</topic>
            </sensor>
            <pose>0 0 0.6 0 0 0</pose>

            <visual name="visual_body">
                <geometry>
                    <box>
                        <size>0.3 0.3 0.8</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.64 0.314 0.095 1</ambient>
                    <diffuse>0.64 0.314 0.095 1</diffuse>
                    <specular>0.64 0.314 0.095 1</specular>
                </material>
            </visual>

            <collision name="collision_body">
                <geometry>
                    <box>
                        <size>0.3 0.3 0.8</size>
                    </box>
                </geometry>
            </collision>

            <inertial>
                <mass>10.0</mass>
                <inertia>
                    <ixx>0.6083</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.6083</iyy>
                    <iyz>0</iyz>
                    <izz>0.15</izz>
                </inertia>
            </inertial>
        </link>

        <link name="left_wheel">
            <pose>0 0.2 0.21 -1.5707963267948966 0 0</pose>
            <visual name="visual_left_wheel">
                <geometry>
                    <cylinder>
                        <radius>0.2</radius>
                        <length>0.1</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.2 0.2 0.2 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>
            <visual name="visual_left_hub1">
                <geometry>
                    <box>
                        <size>0.02 0.075 0.12</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1.0 0.2 0.2 1</ambient>
                    <diffuse>1.0 0.2 0.2 1</diffuse>
                    <specular>1.0 0.2 0.2 1</specular>
                </material>
            </visual>
            <visual name="visual_left_hub2">
                <geometry>
                    <box>
                        <size>0.075 0.02 0.12</size>
                    </box>
                </geometry>

                <material>
                    <ambient>1.0 0.2 0.2 1</ambient>
                    <diffuse>1.0 0.2 0.2 1</diffuse>
                    <specular>1.0 0.2 0.2 1</specular>
                </material>
            </visual>

            <collision name="collision_left_wheel">
                <geometry>
                    <cylinder>
                        <radius>0.2</radius>
                        <length>0.1</length>
                    </cylinder>
                </geometry>
            </collision>

            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.01</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.01</iyy>
                    <iyz>0</iyz>
                    <izz>0.02</izz>
                </inertia>
            </inertial>
        </link>

        <link name="right_wheel">
            <pose>0 -0.2 0.21 -1.5707963267948966 0 0</pose>
            <visual name="visual_right_wheel">
                <geometry>
                    <cylinder>
                        <radius>0.2</radius>
                        <length>0.1</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.2 0.2 0.2 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>
            <visual name="visual_right_hub1">
                <geometry>
                    <box>
                        <size>0.02 0.075 0.12</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1.0 0.2 0.2 1</ambient>
                    <diffuse>1.0 0.2 0.2 1</diffuse>
                    <specular>1.0 0.2 0.2 1</specular>
                </material>
            </visual>
            <visual name="visual_right_hub2">
                <geometry>
                    <box>
                        <size>0.075 0.02 0.12</size>
                    </box>
                </geometry>

                <material>
                    <ambient>1.0 0.2 0.2 1</ambient>
                    <diffuse>1.0 0.2 0.2 1</diffuse>
                    <specular>1.0 0.2 0.2 1</specular>
                </material>
            </visual>

            <collision name="collision_right_wheel">
                <geometry>
                    <cylinder>
                        <radius>0.2</radius>
                        <length>0.1</length>
                    </cylinder>
                </geometry>
            </collision>

            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.01</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.01</iyy>
                    <iyz>0</iyz>
                    <izz>0.02</izz>
                </inertia>
            </inertial>
        </link>

        <joint name="left_wheel_joint" type="revolute">
            <parent>body_com</parent>
            <child>left_wheel</child>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>1.79769e+308</upper>
                </limit>
                <dynamics>
                    <damping>0.1</damping>
                    <spring_reference>0.0</spring_reference>
                    <spring_stiffness>0.0</spring_stiffness>
                </dynamics>
            </axis>
        </joint>

        <joint name="right_wheel_joint" type="revolute">
            <parent>body_com</parent>
            <child>right_wheel</child>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>1.79769e+308</upper>
                </limit>
                <dynamics>
                    <damping>0.1</damping>
                    <spring_reference>0.0</spring_reference>
                    <spring_stiffness>0.0</spring_stiffness>
                </dynamics>
            </axis>
        </joint>

        <plugin filename="TeeterbotInterfacePlugin" name="teeterbot_gazebo::TeeterbotInterfacePlugin"/>
    </model>
</sdf>